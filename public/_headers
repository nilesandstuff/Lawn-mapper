# SECURITY HEADERS for the static pages (owner, 2026-10-04: "is the admin
# page, and all of the pages connected to it, secure?"). Cloudflare reads
# this file; it is not served.
#
# Every page: no MIME sniffing, no full URLs leaked to other sites, HTTPS
# only for a year.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# The consoles: never inside another site's frame (an invisible frame over
# "approve" or "make admin" is how a signed-in admin is tricked into clicking
# them), and never in a search index.
/admin.html
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Robots-Tag: noindex, nofollow
