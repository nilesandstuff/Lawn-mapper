{
  "name": "lawn-mapper",
  "private": true,
  "type": "module",
  "description": "Measures a lawn's square footage from an address. One Cloudflare Worker serves both the API (worker/) and the site (public/).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node tools/area.test.js && node tools/mask.test.js",
